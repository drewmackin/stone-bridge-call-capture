{
  "name": "stone-bridge-call-capture",
  "version": "1.0.0",
  "description": "Stone Bridge Strategic Partners — desktop call-capture: record seller calls, transcribe locally, extract leads with AI, review, and push to Google Sheets.",
  "main": "./out/main/index.js",
  "author": "Stone Bridge Strategic Partners",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "smoke": "SMOKE_TEST=1 electron .",
    "verify": "bash ./scripts/run-selftests.sh",
    "test": "node --test",
    "dist": "electron-vite build && electron-builder --mac --arm64",
    "dist:dir": "electron-vite build && electron-builder --mac --arm64 --dir"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "googleapis": "^140.0.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.39",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.1"
  }
}
