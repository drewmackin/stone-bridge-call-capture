# =============================================================================
# Stone Bridge Call Capture — environment configuration
# Copy this file to ".env" (same folder) and fill in the values.
# The ".env" file is NEVER committed to version control. Keep it private.
# Every value below is explained in plain English in SETUP.md.
# =============================================================================

# --- Anthropic (AI lead extraction) -----------------------------------------
# REQUIRED. Your own Anthropic API key. Used to turn the transcript into
# structured lead fields. Get it at https://console.anthropic.com/ -> API Keys.
# It starts with "sk-ant-".
ANTHROPIC_API_KEY=

# --- Local speaker labels (optional) ----------------------------------------
# OPTIONAL. A free Hugging Face access token enables LOCAL speaker separation
# (who is the seller vs. you) for single-microphone speakerphone recordings.
# Without it, transcripts still work fully — they just won't be labeled by
# speaker. Get a "read" token at https://huggingface.co/settings/tokens and
# accept the model terms (see SETUP.md). Starts with "hf_".
HUGGINGFACE_TOKEN=

# --- Google Sheets (push approved leads) ------------------------------------
# REQUIRED to push leads. Absolute path to the service-account JSON key file
# you downloaded from Google Cloud. Example:
#   /Users/you/stone-bridge-call-capture/service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# OPTIONAL. Leave BLANK to have the app create a new Google Sheet on first run
# (it will print the new Sheet ID + URL and share it with your email below).
# Or paste an existing Sheet ID from its URL:
#   https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=

# Your Google account email. When the app creates the Sheet, it shares it with
# this address so it appears in your Google Drive and you can open it.
OPERATOR_SHARE_EMAIL=drewmackin6@gmail.com

# --- Google Calendar (follow-up events) ---
# When a captured lead has a next-meeting time, the app files an event here.
# Defaults to OPERATOR_SHARE_EMAIL. The Google Calendar API must be enabled and
# this calendar shared with the service-account email ("Make changes to events").
CALENDAR_ID=
# IANA timezone for meeting times parsed without an offset.
CALENDAR_TIMEZONE=America/New_York
# Default event length in minutes.
CALENDAR_EVENT_MINUTES=30

# --- Operator defaults -------------------------------------------------------
# Two-letter code of your home state. Used as the default for the consent gate.
OPERATOR_STATE=MA

# Transcription model size: tiny | base | small | medium
# "small" is the recommended balance of speed and accuracy for phone audio.
WHISPER_MODEL=small

# Audio capture mode.
#   "speakerphone" — phone on speaker -> laptop mic, ONE mixed channel. Speaker
#       separation then relies on AI diarization (needs HUGGINGFACE_TOKEN above).
#   "loopback" — TWO channels (you on the left, the seller on the right), e.g. a
#       ~$20 call-recording adapter or a VoIP/softphone. Each side is transcribed
#       separately and labeled deterministically — near-perfect "you vs. seller"
#       separation with NO AI guessing and no Hugging Face token required.
#       This is the recommended setup if telling the voices apart matters.
AUDIO_MODE=speakerphone

# --- Cloud transcription (optional alternative engine) ----------------------
# OPTIONAL. Only needed if you switch TRANSCRIPTION_ENGINE to "assemblyai".
# Your audio is uploaded to AssemblyAI in that mode. Default engine is local.
TRANSCRIPTION_ENGINE=local
ASSEMBLYAI_API_KEY=
